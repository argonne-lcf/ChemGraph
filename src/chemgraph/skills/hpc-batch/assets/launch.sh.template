#!/bin/bash
# IRI supplies the working directory and scheduler resources via JobSpec.
# Replace both placeholders with quoted, compute-visible paths before staging.
set -eo pipefail
source {{ENVIRONMENT_SETUP_SCRIPT}}
set -u
export CHEMGRAPH_LOG_DIR="$PWD"
export TMPDIR=/tmp
# Single-process ASE example. Set GPU visibility to match the requested calculator.
export OMP_NUM_THREADS=8
export CUDA_VISIBLE_DEVICES=0
exec {{PYTHON_EXECUTABLE}} calculate.py
