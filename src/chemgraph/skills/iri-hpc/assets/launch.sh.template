#!/bin/bash
# IRI runs this script with bash; the JobSpec selects resources, so #PBS lines are ignored.
# iri_prepare.py replaces {{ENVIRONMENT_SETUP}} and {{PYTHON}} from target.toml.
set -eo pipefail
RUN_DIR=$(cd "$(dirname "$0")" && pwd)
{{ENVIRONMENT_SETUP}}
set -u
cd "$RUN_DIR"
# ALCF compute nodes reach the internet (e.g. model downloads) only through this proxy.
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy"
export CHEMGRAPH_LOG_DIR="$RUN_DIR" TMPDIR=/tmp
exec {{PYTHON}} "$RUN_DIR/calculate.py"
